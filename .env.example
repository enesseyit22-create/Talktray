# Copy to .env. Do not commit real keys.
# Leave the placeholders to run in demo mode with on-device parsing.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_PUBLIC_SDK_KEY

# Optional. Used only for the Google OAuth client configuration in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID

# Screenshot / local preview. Unset for a normal first launch.
# EXPO_PUBLIC_PREVIEW=1
# EXPO_PUBLIC_PREVIEW_LOCALE=tr
# EXPO_PUBLIC_PREVIEW_NAME=Enes
