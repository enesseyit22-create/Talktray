{
  "expo": {
    "name": "Talktray",
    "slug": "talktray",
    "owner": "fishmaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talktray",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/02e5d8f6-f11d-421c-92c9-2d4f699eed65",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.talktray.app",
      "appleTeamId": "5B7448U5F6",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.talktray.app"]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Talktray uses the microphone only while you are recording, so it can turn what you say into tasks, reminders, and notes. It does not record in the background.",
        "NSCalendarsUsageDescription": "Talktray can add the events you confirm to your calendar.",
        "NSRemindersUsageDescription": "Talktray can save the reminders you confirm to the Reminders app.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.talktray.app",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#D7EEE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7F6F1",
          "image": "./assets/images/icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "tr", "es", "pt-BR", "de", "fr", "it", "ja", "ko", "id"],
            "android": ["en", "tr", "es", "pt-BR", "de", "fr", "it", "ja", "ko", "id"]
          }
        }
      ],
      "expo-audio",
      "expo-updates",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8B7CFF"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "record",
              "title": "Kaydet",
              "subtitle": "Talktray ile kaydet",
              "icon": "symbol:mic.fill",
              "params": {
                "href": "/record?autostart=1"
              }
            }
          ]
        }
      ],
      "./modules/talktray-capture/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json",
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-BR.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "id": "./locales/id.json"
    },
    "extra": {
      "eas": {
        "projectId": "02e5d8f6-f11d-421c-92c9-2d4f699eed65"
      },
      "recordUrl": "talktray://record"
    }
  }
}
