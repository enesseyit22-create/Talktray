    android:enabled="true"
    android:icon="@drawable/ic_talktray_mic"
    android:shortcutId="record"
    android:shortcutLongLabel="@string/talktray_shortcut_long"
    android:shortcutShortLabel="@string/talktray_shortcut_short">
